<section class="product-grid-section">
  <div class="grid">

    {% for block in section.blocks %}
      {% assign product = block.settings.product %}

      <div class="card" data-handle="{{ product.handle }}">
        {% if product %}
          <img 
            src="{{ product.featured_image | image_url: width: 500 }}"
            width="500"
            height="500"
            alt="{{ product.title }}"
            loading="lazy"
          >
          <h3>{{ product.title }}</h3>
          <p>{{ product.price | money }}</p>
        {% else %}
          <div style="color:red;">No product selected</div>
        {% endif %}
      </div>

    {% endfor %}

  </div>
</section>

<!-- POPUP -->
<div id="popup" class="popup hidden">
  <div class="popup-inner">
    <span class="close">&times;</span>

    <img id="popup-img" width="400" height="400" alt="Product Image">
    <h2 id="popup-title"></h2>
    <p id="popup-price"></p>
    <p id="popup-desc"></p>

    <select id="variant-select"></select>

    <button id="add-to-cart">Add to Cart</button>
  </div>
</div>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}
<section class="custom-banner" 
  style="background-color: #000; 
         {% if section.settings.bg_image != blank %}
         background-image: url({{ section.settings.bg_image | image_url }});
         {% endif %}
         background-size: cover;
         background-position: center;">

  <div class="custom-banner__content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>

    <a href="{{ section.settings.button_link }}" class="custom-banner__btn">
      {{ section.settings.button_text }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Welcome to Store" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Best products available" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [
    { "name": "Custom Banner" }
  ]
}
{% endschema %}